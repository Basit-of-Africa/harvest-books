# Postgres connection string. On Neon, use the pooled connection string (host contains "-pooler").
DATABASE_URL=postgres://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/farmtrace?sslmode=require

# 32 random bytes, base64. Encrypts each business's NRS API key and secret. Generate with: openssl rand -base64 32
# Keep it safe: if it changes, saved NRS credentials can no longer be read and must be entered again.
ENCRYPTION_KEY=

# Public address of the app, used in invitation links, e.g. https://farmtrace.vercel.app
APP_URL=

# Optional: email for sending invoices and invitations (any SMTP service, e.g. Zoho, Brevo, Mailgun, Gmail app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FarmTrace <invoices@example.ng>"

# Secret for the daily retention clean-up (Vercel Cron calls /api/cron/purge with it). Generate with: openssl rand -hex 32
CRON_SECRET=

# Shown in the Privacy Policy and Terms. Fill in the legal entity that operates this deployment.
LEGAL_ENTITY="FarmTrace Technologies Ltd"
LEGAL_ADDRESS="Lagos, Nigeria"
PRIVACY_EMAIL=privacy@example.ng
SUPPORT_EMAIL=support@example.ng
# Where the database is hosted, in plain words (match your Neon region)
DATA_REGION="the European Union (Frankfurt, Germany)"
# Your NDPC registration number, once registered as a data controller/processor
NDPC_REGISTRATION=
# How long the security audit log is kept, in days (default 730)
AUDIT_RETENTION_DAYS=730
